# Telegram bot token from @BotFather (/newbot)
TELEGRAM_BOT_TOKEN=

# Your numeric Telegram chat id (message your bot once, then check
# https://api.telegram.org/bot<TOKEN>/getUpdates -> result[0].message.chat.id)
TELEGRAM_CHAT_ID=

# OPTIONAL, multi-user mode: each key is a private SQLite namespace.
# USERS=[{"chatId":"111","key":"you","name":"You"},{"chatId":"222","key":"partner","name":"Partner"}]

# DeepSeek API key from https://platform.deepseek.com
DEEPSEEK_API_KEY=
# Optional model for food-photo analysis (defaults to deepseek-flash)
# DEEPSEEK_VISION_MODEL=deepseek-flash

# Single-user SQLite namespace (ignored when USERS is set)
STORAGE_KEY=you

# Optional one-time migration only: old USERS entries with "repo" import from GitHub
# using this read-only token. Remove it after migration completes.
# GITHUB_TOKEN=

# Any long random string; Telegram echoes it on every webhook call so the app
# can reject forged requests. Generate with: openssl rand -hex 24
WEBHOOK_SECRET=
